{
  "name": "folio-reader",
  "version": "1.0.0",
  "description": "A compact offline PDF reader with a persistent local bookshelf.",
  "author": "TolibovZafarali",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "build:ui": "node scripts/prepare-pdf.mjs && vite build",
    "start": "npm run build:ui && electron .",
    "build": "npm run build:ui && electron-builder --win portable --x64 --publish never",
    "test": "node --test test/library.test.cjs",
    "test:app": "npm run build:ui && node --test test/electron.test.mjs"
  },
  "build": {
    "appId": "com.folio.reader",
    "productName": "Folio Reader",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "library.cjs",
      "ui/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "Folio-Reader-${version}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.0",
    "vite": "^8.3.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TolibovZafarali/any-to-pdf.git",
    "directory": "desktop"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
